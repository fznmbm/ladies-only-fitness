# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server only. Never put this in a NEXT_PUBLIC_ variable or share it.
# Used for the public join form and the ladies' personal links.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Backblaze B2, for storing receipt photos. From the bucket's page in the B2
# dashboard (Endpoint) and an Application Key scoped to just this bucket.
B2_ENDPOINT=https://s3.YOUR-REGION.backblazeb2.com
B2_REGION=YOUR-REGION
B2_BUCKET=ladies-fitness-receipts
B2_KEY_ID=YOUR-KEY-ID
B2_APPLICATION_KEY=YOUR-APPLICATION-KEY

# Shown on the Pay screen so bank transfers reach the right account.
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=

# Shown at the top of each screen
NEXT_PUBLIC_GROUP_NAME=Ladies Fitness

# Your live address, used when building links to send on WhatsApp (no trailing slash).
# Leave it out while testing on localhost.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# A secret word added to the join link so only people in the WhatsApp group can ask to join.
# Leave it empty to allow anyone with the link.
JOIN_CODE=choose-a-word


